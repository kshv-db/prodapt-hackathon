# Supabase project URL and public anon key — safe for client-side/browser use.
# RLS policies enforce data isolation even with the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Bypasses Row Level Security entirely.
# NEVER expose this to the browser/frontend bundle or commit a real value.
# Only backend/server code (Next.js route handlers, server actions, seed jobs) may use it.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key — server-side only (owned by the AI engineer role, listed here for
# completeness since it shares the same "never commit" rule).
OPENAI_API_KEY=
