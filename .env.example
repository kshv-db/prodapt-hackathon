# Supabase project URL and public anon key - safe for client-side/browser use.
# RLS policies enforce data isolation even with the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Bypasses Row Level Security entirely.
# NEVER expose this to the browser/frontend bundle or commit a real value.
# NOT used by the Next.js backend (it uses the anon key + the caller's JWT so RLS always applies).
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key - server-side only.
OPENAI_API_KEY=

# Optional model overrides (defaults live in lib/ai/config.ts)
OPENAI_MODEL_FAST=
OPENAI_MODEL_MID=
