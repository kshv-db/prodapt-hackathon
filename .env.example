# Supabase (public values are safe for the browser; there is NO service-role key in this app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (server-side only - never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=

# Optional model overrides (defaults live in lib/ai/config.ts)
OPENAI_MODEL_FAST=
OPENAI_MODEL_MID=
